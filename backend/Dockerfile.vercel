FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn --batch-mode --no-transfer-progress -DskipTests package

FROM eclipse-temurin:21-jre-jammy AS java-runtime
WORKDIR /app
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:TieredStopAtLevel=1 -Djava.io.tmpdir=/tmp"

FROM java-runtime AS archive
COPY --from=build /build/target/student-management-1.0.0.jar /tmp/app.jar
# Extract dependencies and prepare the class cache once, during the image build.
# Training uses only an in-memory database and never needs production credentials.
RUN java -Djarmode=tools -jar /tmp/app.jar extract --destination /app \
    && java -XX:ArchiveClassesAtExit=application.jsa -Dspring.context.exit=onRefresh \
       -jar app.jar \
       --spring.datasource.url=jdbc:h2:mem:cds \
       --spring.jpa.hibernate.ddl-auto=none \
       --spring.flyway.enabled=false --app.seed=false --server.port=0

FROM java-runtime
COPY --from=archive /app/ /app/
ENV SPRING_PROFILES_ACTIVE=vercel \
    PORT=8080
EXPOSE 8080
USER 10001:10001
ENTRYPOINT ["java", "-XX:SharedArchiveFile=application.jsa", "-jar", "app.jar"]
