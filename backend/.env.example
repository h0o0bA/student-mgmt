# Example only. Spring does not automatically load this file.
# Set these values in Vercel, or copy to an ignored .env for Docker --env-file.
PORT=8080
DATABASE_JDBC_URL=jdbc:postgresql://your-database-host:5432/student_mgmt?sslmode=require
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=replace-with-database-password
# Optional: a reachable JSON Server GET /api/courses endpoint for catalog imports.
# Never use localhost here in a cloud deployment.
CATALOG_API_URL=
