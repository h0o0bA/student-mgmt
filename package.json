{
  "name": "student-management",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web \"npm:api\" \"npm:serve\"",
    "serve": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "api": "node mock/server.cjs",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:api": "node --test mock/server.test.cjs",
    "start:spring": "ng serve --host 127.0.0.1 --proxy-config proxy.spring.conf.json",
    "db:reset": "node mock/reset.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.9.0",
    "json-server": "0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
